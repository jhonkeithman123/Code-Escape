# Android release signing configuration (DO NOT COMMIT real secrets)
# Copy to `keystore.properties` in the project root (gitignored) or provide equivalent
# environment variables/Gradle properties in CI.
#
# Supported sources (checked in this order by android/build.gradle):
# 1) keystore.properties: storeFile, storePassword, keyAlias, keyPassword
# 2) Environment variables: ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# 3) Gradle properties: android.injected.signing.store.file/password/key.alias/key.password
#
# `storeFile` may be an absolute path or a path relative to the project root.

storeFile=path/to/release-keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
